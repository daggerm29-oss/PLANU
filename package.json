    "typecheck": "tsc --build",
    "dev:worldview": "npm run dev --workspace=@workspace/worldview"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1",
    "@types/react": "19.1.0",
    "@types/node": "^22"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
